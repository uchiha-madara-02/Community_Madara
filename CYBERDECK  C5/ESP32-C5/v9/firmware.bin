wakeup_enable␀␀gpio_isr_register␀␀␀gpio_isr_handler_remove␀gpio_isr_handler_add␀␀␀␀gpio_install_isr_service␀␀␀␀gpio_reset_pin␀␀gpio_input_disable␀␀gpio_set_direction␀␀gpio_set_level␀␀gpio_od_enable␀␀gpio_od_disable␀gpio_output_enable␀␀gpio_output_disable␀gpio_input_enable␀␀␀gpio_intr_disable␀␀␀gpio_intr_enable␀␀␀␀gpio_set_intr_type␀␀gpio_pulldown_dis␀␀␀gpio_pulldown_en␀␀␀␀gpio_pullup_dis␀gpio_pullup_en␀␀rtc_gpio_wakeup_disable␀rtc_gpio_wakeup_enable␀␀rtc_gpio_iomux_func_sel␀rtc_gpio_pulldown_dis␀␀␀rtc_gpio_pullup_dis␀rtc_gpio_pullup_en␀␀rtc_gpio_set_direction␀␀rtc_gpio_deinit␀rtc_gpio_init␀␀␀esp_ota_get_running_partition␀␀␀esp_ota_get_app_partition_count␀esp_partition_get␀␀␀esp_partition_next␀␀esp_partition_mmap␀␀esp_partition_erase_range␀␀␀esp_partition_write_raw␀esp_partition_read_raw␀␀esp_partition_write␀esp_partition_read␀␀esp_efuse_utility_read_reg␀␀esp_efuse_utility_process␀␀␀È0␀0␀(␀ ␀␀␀␀␀␀,H`@H`DH`XH`\H`xH`|H`˜H`œH`¸H`¼H`ØH`ÜH`øH`üH`I`I`8I`<I`XI`\I`xI`bootloader_flash_execute_command_common␀bootloader_sha256_finish␀␀␀␀bootloader_sha256_data␀␀spi_flash_munmap␀␀␀␀esp_flash_write␀esp_flash_erase_region␀␀E (%lu) %s: chip %s doesn't support reading unique id
