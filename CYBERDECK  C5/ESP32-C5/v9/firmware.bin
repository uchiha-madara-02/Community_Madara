zuyywwwvyvvvvzvvzvzvwzuzuzuEŸO$¿vÿÿQ$Áv␀␀␀␀üB␀␀€?␀␀À?␀␀HB␀␀¸B␀␀0B␀␀€>␀␀ B␀␀€A␀␀°A␀␀zD␀␀ÈB␀␀␀?␀␀€=␀␀>N×G­öt1|ò“4Ğ7a¶:«ª*=ÓÉ./4/×2ï86P9‰ˆ<«ª*>€É?CD57␀D57£….„ù"?␀£….21$␀␀€C␀␀€;␀␀␀>␀␀␀AÊòIq␀␀␀L`B¢ÊòIñ`B¢␀␀␀3UUªª ª«ª¬ª­ª'␀␀ N␀␀0u␀␀@œ␀␀PÃ␀␀`ê␀␀␀␀␀␀␀␀␀␀@␀␀␀€␀␀␀À␀␀␀ÿ␀␀␀␀␀␀␀␀␀␀␀ÂBØBöB´BÒB„`B˜`B¨`BÀ`BØ`Bè`Bü`BaB(aB
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>CYBERDECK // ROOT_ACCESS</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap');

        :root {
            --neon-red: #ff003c;
            --neon-cyan: #00f0ff;
            --neon-yellow: #fcee0a;
            --neon-green: #00ff41;
            --neon-green-glow: rgba(0, 255, 65, 0.3);
            --bg-deep: #020202;
            --bg-panel: rgba(10, 10, 15, 0.85);
            --text-main: #e0e0e0;
            --text-dim: #444;
            --font-cyber: 'Share Tech Mono', 'Courier New', monospace;
        }

        * { box-sizing: border-box; touch-action: manipulation; }

        body {
            background-color: var(--bg-deep);
            background-image: 
                linear-gradient(rgba(0, 240, 255, 0.07) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 240, 255, 0.07) 1px, transparent 1px);
            background-size: 30px 30px;
            color: var(--text-main);
            font-family: var(--font-cyber);
            margin: 0; padding: 15px;
            overflow-x: hidden; text-transform: uppercase;
            display: flex; justify-content: center; align-items: center; min-height: 100vh;
        }

        body::before {
            content: " "; display: block; position: fixed; top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), 
                        linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            z-index: 998; background-size: 100% 2px, 3px 100%; pointer-events: none;
        }

        body::after {
            content: ""; position: fixed; top: -10%; left: 0; width: 100%; height: 50px;
            background: linear-gradient(to bottom, transparent, rgba(0, 240, 255, 0.1), transparent);
            z-index: 999; pointer-events: none; animation: scanline 6s linear infinite;
        }
        @keyframes scanline { 0% { top: -10%; } 100% { top: 110%; } }

        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #000; border-left: 1px solid #222; }
        ::-webkit-scrollbar-thumb { background: var(--neon-cyan); }
        ::-webkit-scrollbar-thumb:hover { background: var(--neon-red); }

        /* KHUNG CYBERDECK CHÃNH */
        .container {
            width: 95%; max-width: 950px; max-height: 88vh; display: flex; flex-direction: column;
            background: var(--bg-panel); border: 1px solid var(--neon-cyan);
            box-shadow: 0 30px 60px rgba(0,0,0,0.9), 0 0 25px rgba(0,240,255,0.2), inset 0 0 20px rgba(0,240,255,0.1);
            position: relative; backdrop-filter: blur(8px);
            clip-path: polygon(25px 0, 100% 0, 100% calc(100% - 25px), calc(100% - 25px) 100%, 0 100%, 0 25px);
            animation: deckBoot 0.7s cubic-bezier(0.1, 0.9, 0.2, 1) forwards;
            transform: translateY(50px) scale(0.95); opacity: 0; z-index: 10;
        }
        @keyframes deckBoot { to { transform: translateY(0) scale(1); opacity: 1; } }

        .container::before { content: ''; position: absolute; top: 0; right: 0; width: 150px; height: 4px; background: var(--neon-red); }
        .container::after { content: ''; position: absolute; bottom: 0; left: 0; width: 150px; height: 4px; background: var(--neon-yellow); }

        .header {
            background: repeating-linear-gradient(-45deg, #0a0a0a, #0a0a0a 10px, #000 10px, #000 20px);
            border-bottom: 2px solid var(--neon-cyan);
            padding: 15px 25px; display: flex; flex-wrap: wrap; gap: 15px; justify-content: space-between; align-items: center; flex-shrink: 0;
        }

        .glitch {
            font-size: 24px; font-weight: bold; color: var(--text-main); position: relative; margin: 0; 
            text-shadow: 0.05em 0 0 rgba(255,0,0,0.75), -0.025em -0.05em 0 rgba(0,255,0,0.75), 0.025em 0.05em 0 rgba(0,0,255,0.75);
            animation: glitch 2s infinite;
        }
        .glitch::before, .glitch::after { content: attr(data-text); position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
        .glitch::before { left: 2px; text-shadow: -2px 0 var(--neon-red); clip: rect(24px, 550px, 90px, 0); animation: glitch-anim-2 3s infinite linear alternate-reverse; }
        .glitch::after { left: -2px; text-shadow: -2px 0 var(--neon-cyan); clip: rect(85px, 550px, 140px, 0); animation: glitch-anim 2.5s infinite linear alternate-reverse; }
        @keyframes glitch { 0% { text-shadow: 0.05em 0 0 rgba(255,0,0,0.75), -0.05em -0.025em 0 rgba(0,255,0,0.75), -0.025em 0.05em 0 rgba(0,0,255,0.75); }
            14% { text-shadow: 0.05em 0 0 rgba(255,0,0,0.75), -0.05em -0.025em 0 rgba(0,255,0,0.75), -0.025em 0.05em 0 rgba(0,0,255,0.75); }
            15% { text-shadow: -0.05em -0.025em 0 rgba(255,0,0,0.75), 0.025em 0.025em 0 rgba(0,255,0,0.75), -0.05em -0.05em 0 rgba(0,0,255,0.75); }
            49% { text-shadow: -0.05em -0.025em 0 rgba(255,0,0,0.75), 0.025em 0.025em 0 rgba(0,255,0,0.75), -0.05em -0.05em 0 rgba(0,0,255,0.75); }
            50% { text-shadow: 0.025em 0.05em 0 rgba(255,0,0,0.75), 0.05em 0 0 rgba(0,255,0,0.75), 0 -0.05em 0 rgba(0,0,255,0.75); }
            100% { text-shadow: -0.025em 0 0 rgba(255,0,0,0.75), -0.025em -0.025em 0 rgba(0,255,0,0.75), -0.025em -0.05em 0 rgba(0,0,255,0.75); }
        }

        .sys-status { font-size: 13px; color: var(--bg-deep); background: var(--neon-cyan); padding: 5px 15px; font-weight: bold; clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px); box-shadow: 0 0 15px rgba(0, 240, 255, 0.3); }
        .sys-status span { color: var(--neon-red); }

        .toolbar { padding: 15px 25px; border-bottom: 1px solid #1a1a24; display: flex; flex-wrap: wrap; gap: 10px; flex-shrink: 0;}
        .path-display { flex-basis: 100%; color: var(--neon-yellow); font-size: 16px; margin-bottom: 10px; background: #000; padding: 10px; border-left: 3px solid var(--neon-yellow); word-break: break-all; }

        .btn {
            background: rgba(0, 240, 255, 0.05); color: var(--neon-cyan); border: 1px solid var(--neon-cyan);
            padding: 10px 20px; font-family: var(--font-cyber); font-size: 14px; font-weight: bold; cursor: pointer;
            flex-grow: 1; text-align: center; position: relative; overflow: hidden; transition: 0.2s;
            clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
        }
        .btn:hover { background: var(--neon-cyan); color: #000; box-shadow: 0 0 15px var(--neon-cyan); text-shadow: none; }
        .btn-red { color: var(--neon-red); border-color: var(--neon-red); background: rgba(255,0,60,0.05); }
        .btn-red:hover { background: var(--neon-red); color: #000; box-shadow: 0 0 15px var(--neon-red); }

        .table-wrapper { width: 100%; overflow-y: auto; overflow-x: auto; padding: 20px; flex-grow: 1; }
        table { width: 100%; min-width: 600px; border-collapse: collapse; }
        th { color: var(--text-dim); font-size: 12px; letter-spacing: 2px; padding: 10px; border-bottom: 1px dashed var(--neon-cyan); text-align: left; }
        td { padding: 12px 10px; border-bottom: 1px solid #111; font-size: 15px; }
        tr { transition: background 0.2s; }
        tr:hover { background: rgba(0, 240, 255, 0.05); }

        .icon { width: 40px; display: inline-block; color: var(--neon-red); font-weight: bold; }
        .file-name { cursor: pointer; color: var(--text-main); font-weight: bold; transition: 0.2s; }
        .file-name:hover { color: var(--neon-cyan); text-shadow: 0 0 8px var(--neon-cyan); letter-spacing: 1px; }
        .file-name:hover::before { content: "> "; color: var(--neon-yellow); }
        
        .actions button { background: transparent; border: 1px solid #333; cursor: pointer; font-family: var(--font-cyber); font-size: 12px; padding: 6px 10px; margin-left: 5px; color: var(--text-main); transition: 0.2s; clip-path: polygon(5px 0, 100% 0, 100% calc(100% - 5px), calc(100% - 5px) 100%, 0 100%, 0 5px); }
        .actions button:hover { border-color: var(--neon-cyan); background: var(--neon-cyan); color: #000; }
        .actions .act-del:hover { border-color: var(--neon-red); background: var(--neon-red); color: #000; }

        /* [Má»šI] STYLE CHO UPLOAD PROGRESS BAR */
        .progress-text { color: var(--neon-cyan); text-align: center; font-size: 18px; font-weight: bold; letter-spacing: 2px; margin-bottom: 15px; }
        .progress-text span { color: var(--neon-yellow); }
        .progress-container { width: 80%; margin: 0 auto; border: 1px solid var(--neon-cyan); background: #000; height: 16px; position: relative; box-shadow: 0 0 15px rgba(0,240,255,0.2); }
        .progress-fill { height: 100%; width: 0%; background: var(--neon-cyan); box-shadow: 0 0 15px var(--neon-cyan); transition: width 0.15s ease, background 0.3s; }

        .modal-overlay {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.9); z-index: 1000; backdrop-filter: blur(5px);
            justify-content: center; align-items: center;
        }

        /* EDITOR MODAL */
        .editor-content {
            width: 95%; max-width: 1100px; height: 90vh; 
            background: linear-gradient(135deg, #050a05 0%, #000000 100%);
            border: 1px solid rgba(0, 255, 65, 0.2);
            border-left: 4px solid var(--neon-green); 
            box-shadow: 0 0 50px rgba(0,255,65,0.1), 0 20px 50px rgba(0,0,0,0.9); 
            display: flex; flex-direction: column; 
            clip-path: polygon(25px 0, 100% 0, 100% calc(100% - 25px), calc(100% - 25px) 100%, 0 100%, 0 25px);
            animation: crtBoot 0.4s cubic-bezier(0.1, 0.9, 0.2, 1) forwards;
            position: relative;
        }

        @keyframes crtBoot {
            0% { transform: scaleY(0.01) scaleX(0); opacity: 0; }
            50% { transform: scaleY(0.01) scaleX(1); opacity: 1; }
            100% { transform: scaleY(1) scaleX(1); opacity: 1; }
        }

        .editor-content::after {
            content: ''; position: absolute; top: 15px; right: 40px; width: 8px; height: 8px;
            background: var(--neon-red); box-shadow: 0 0 10px var(--neon-red); border-radius: 50%;
            animation: blink 1s infinite; pointer-events: none;
        }
        @keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }

        .editor-header {
            background: rgba(0, 255, 65, 0.05); color: var(--neon-green); 
            padding: 12px 20px; font-weight: bold; font-size: 16px; 
            display: flex; justify-content: space-between; align-items: center; 
            letter-spacing: 2px; border-bottom: 1px solid rgba(0, 255, 65, 0.3);
            text-shadow: 0 0 8px var(--neon-green-glow);
        }
        
        .editor-header span:last-child { color: var(--neon-red); font-size: 20px; transition: 0.2s; text-shadow: none; }
        .editor-header span:last-child:hover { color: #fff; text-shadow: 0 0 10px var(--neon-red); }

        .textarea-wrapper {
            flex-grow: 1; position: relative; overflow: hidden;
            background-image: 
                linear-gradient(rgba(0, 255, 65, 0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 255, 65, 0.05) 1px, transparent 1px);
            background-size: 30px 30px;
        }

        textarea {
            width: 100%; height: 100%; background: transparent; color: var(--neon-green);
            border: none; padding: 25px; font-family: var(--font-cyber); resize: none; 
            font-size: 16px !important; outline: none; line-height: 1.6; 
            text-shadow: 0 0 5px rgba(0,255,65,0.4);
        }
        textarea::-webkit-scrollbar-thumb { background: rgba(0, 255, 65, 0.3); }
        textarea::-webkit-scrollbar-thumb:hover { background: var(--neon-green); }
        textarea::selection { background: var(--neon-green); color: #000; text-shadow: none; }

        .editor-footer { padding: 15px 25px; display: flex; justify-content: space-between; align-items: center; background: #020402; border-top: 1px solid rgba(0, 255, 65, 0.3); }
        .editor-tech-info { color: var(--text-dim); font-size: 12px; letter-spacing: 1px; display: flex; gap: 15px; }
        .editor-tech-info span { color: var(--neon-green); opacity: 0.7; }
        .editor-footer .btn-group { display: flex; gap: 15px; }
        .editor-footer .btn-green { border-color: var(--neon-green); color: var(--neon-green); background: rgba(0,255,65,0.05); }
        .editor-footer .btn-green:hover { background: var(--neon-green); color: #000; box-shadow: 0 0 15px var(--neon-green); }

        /* KHUNG HIá»‚N THá»Š MEDIA */
        .media-content {
            width: 95%; max-width: 900px; background: #050505; border: 1px solid var(--neon-cyan);
            box-shadow: 0 0 40px rgba(0,240,255,0.3), 0 20px 50px rgba(0,0,0,0.9); display: flex; flex-direction: column;
            clip-path: polygon(20px 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%, 0 20px);
            animation: deckBoot 0.4s cubic-bezier(0.1, 0.9, 0.2, 1) forwards;
        }
        .media-header { background: var(--neon-cyan); color: #000; padding: 10px 20px; font-weight: bold; font-size: 16px; display: flex; justify-content: space-between; align-items: center; letter-spacing: 2px; }
        .media-body { padding: 20px; display: flex; justify-content: center; align-items: center; background: repeating-linear-gradient(45deg, #050505, #050505 10px, #0a0a0a 10px, #0a0a0a 20px); min-height: 300px; max-height: 75vh;}
        .media-body img { max-width: 100%; max-height: 70vh; object-fit: contain; border: 1px solid var(--neon-cyan); box-shadow: 0 0 15px var(--neon-cyan-glow); }
        .media-body video { max-width: 100%; max-height: 70vh; outline: none; border: 1px solid var(--neon-red); box-shadow: 0 0 20px var(--neon-red-glow); }
        .media-body audio { width: 90%; max-width: 500px; outline: none; border: 1px solid var(--neon-yellow); box-shadow: 0 0 20px rgba(252, 238, 10, 0.3); border-radius: 30px; background: #050505; }
        .audio-visualizer { font-size: 60px; color: var(--neon-yellow); margin-bottom: 25px; text-shadow: 0 0 15px var(--neon-yellow); animation: pulseAudio 0.8s infinite alternate; }
        @keyframes pulseAudio { 0% { transform: scale(1); opacity: 0.7; } 100% { transform: scale(1.1); opacity: 1; } }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h1 class="glitch" data-text="CYBERDECK_OS // V.2.0">CYBERDECK_OS // V.2.0</h1>
        <div class="sys-status">UPLINK_IP: <span id="ip-display">0.0.0.0</span></div>
    </div>

    <div class="toolbar">
        <div class="path-display">root@madara:~<span id="current-path" style="color:var(--neon-cyan)">/</span># _</div>
        <button class="btn" onclick="refreshList()">[ REFRESH_NODE ]</button>
        <button class="btn" onclick="document.getElementById('file-upload').click()">[ INJECT_PAYLOAD ]</button>
        <button class="btn" onclick="createFolder()">[ MKDIR ]</button>
        <input type="file" id="file-upload" style="display: none;" onchange="uploadFileWithProgress(this)">
    </div>

    <div class="table-wrapper">
        <table id="file-table">
            <thead>
                <tr>
                    <th>DATA_OBJECT</th>
                    <th>CAPACITY</th>
                    <th style="text-align: right;">OVERRIDE</th>
                </tr>
            </thead>
            <tbody id="file-list">
                <tr><td colspan="3" style="text-align: center; color: var(--neon-cyan); font-size: 18px; padding: 40px;">> ESTABLISHING SECURE CONNECTION... <br><span style="font-size:12px; color:var(--text-dim)">[PLEASE WAIT]</span></td></tr>
            </tbody>
        </table>
    </div>
</div>

<div id="editor-modal" class="modal-overlay">
    <div class="editor-content">
        <div class="editor-header">
            <div id="editor-title"><span style="animation: blink 1s infinite;">â–ˆ</span> SYS.EDIT // RAW_STREAM</div>
            <span style="cursor:pointer;" onclick="closeEditor()">[X]</span>
        </div>
        
        <div class="textarea-wrapper">
            <textarea id="editor-textarea" spellcheck="false"></textarea>
        </div>
        
        <div class="editor-footer">
            <div class="editor-tech-info">
                <div>MODE: <span>OVR_WRITE</span></div>
                <div>ENCODING: <span>UTF-8</span></div>
            </div>
            <div class="btn-group">
                <button class="btn btn-red" onclick="closeEditor()">[ ABORT ]</button>
                <button class="btn btn-green" onclick="saveFile()">[ WRITE_TO_FLASH ]</button>
            </div>
        </div>
    </div>
</div>

<div id="media-modal" class="modal-overlay">
    <div class="media-content">
        <div class="media-header" id="media-header-bar">
            <span id="media-title">DATA_STREAM // RENDER</span>
            <span style="cursor:pointer; font-size: 22px;" onclick="closeMedia()">[X]</span>
        </div>
        <div class="media-body" id="media-container">
            </div>
    </div>
</div>

<script>
    let currentPath = "/";

    function refreshList() {
        document.getElementById("current-path").innerText = currentPath;
        const tbody = document.getElementById("file-list");
        tbody.innerHTML = '<tr><td colspan="3" style="text-align: center; color: var(--neon-yellow); padding:30px;">> SCANNING MEMORY SECTORS...</td></tr>';

        fetch(`/api/list?dir=${currentPath}`)
            .then(response => response.json())
            .then(data => {
                tbody.innerHTML = "";
                if (currentPath !== "/") {
                    tbody.innerHTML += `
                        <tr>
                            <td colspan="3"><span class="icon" style="color:var(--neon-cyan)">[<]</span><span class="file-name" onclick="goUp()">PARENT_DIR</span></td>
                        </tr>`;
                }

                data.forEach(item => {
                    let icon = item.isDir ? "[DIR]" : "[BIN]";
                    let iconColor = item.isDir ? "var(--neon-yellow)" : "var(--neon-red)";
                    let sizeStr = item.isDir ? "---" : formatBytes(item.size);
                    let clickAct = item.isDir ? `openDir('${item.name}')` : `handleFileClick('${item.name}')`;
                    
                    let row = `<tr>
                        <td><span class="icon" style="color:${iconColor}">${icon}</span><span class="file-name" onclick="${clickAct}">${item.name}</span></td>
                        <td style="color: var(--text-dim);">${sizeStr}</td>
                        <td class="actions" style="text-align: right;">`;
                    
                    if (!item.isDir) {
                        row += `<button onclick="downloadFile('${item.name}')">DL</button>
                                <button onclick="handleFileClick('${item.name}')">VIEW</button>`;
                    }
                    row += `<button class="act-del" onclick="deleteItem('${item.name}', ${item.isDir})">DEL</button></td></tr>`;
                    tbody.innerHTML += row;
                });
            })
            .catch(err => {
                tbody.innerHTML = `<tr><td colspan="3" style="color:var(--neon-red); text-align:center; padding:30px; font-weight:bold;">> FATAL ERROR: NO LINK DETECTED</td></tr>`;
            });
    }

    function formatBytes(bytes) {
        if(bytes === 0) return '0 B';
        const k = 1024, sizes = ['B', 'KB', 'MB'], i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    }

    function openDir(name) { currentPath += name + "/"; refreshList(); }
    function goUp() {
        let parts = currentPath.split("/").filter(p => p !== ""); parts.pop();
        currentPath = parts.length > 0 ? "/" + parts.join("/") + "/" : "/";
        refreshList();
    }
    
    function getFileType(filename) {
        let ext = filename.split('.').pop().toLowerCase();
        const images = ['jpg', 'jpeg', 'png', 'gif', 'webp', 'bmp', 'svg', 'ico'];
        const videos = ['mp4', 'webm', 'ogg', 'mov'];
        const audios = ['mp3', 'wav', 'flac', 'aac', 'm4a']; 
        const texts = ['txt', 'html', 'css', 'js', 'json', 'ir', 'cpp', 'h', 'csv', 'xml', 'md', 'log', 'ini'];
        
        if (images.includes(ext)) return 'image';
        if (videos.includes(ext)) return 'video';
        if (audios.includes(ext)) return 'audio';
        if (texts.includes(ext)) return 'text';
        return 'other'; 
    }

    function handleFileClick(name) {
        let type = getFileType(name);
        if (type === 'image') viewMedia(name, 'image');
        else if (type === 'video') viewMedia(name, 'video');
        else if (type === 'audio') viewMedia(name, 'audio'); 
        else if (type === 'text') editFile(name);
        else downloadFile(name); 
    }

    function viewMedia(name, type) {
        let fullPath = currentPath + name;
        let fileUrl = `/api/download?path=${encodeURIComponent(fullPath)}`;
        let container = document.getElementById('media-container');
        let headerBar = document.getElementById('media-header-bar');
        
        document.getElementById('media-title').innerText = `DATA_STREAM // ${name}`;
        
        if (type === 'image') {
            headerBar.style.background = 'var(--neon-cyan)'; 
            container.innerHTML = `<img src="${fileUrl}" alt="${name}">`;
        } else if (type === 'video') {
            headerBar.style.background = 'var(--neon-red)'; 
            container.innerHTML = `<video src="${fileUrl}" controls autoplay></video>`;
        } else if (type === 'audio') {
            headerBar.style.background = 'var(--neon-yellow)'; 
            container.innerHTML = `
                <div style="display:flex; flex-direction:column; align-items:center; width:100%;">
                    <div class="audio-visualizer">â™«</div>
                    <audio src="${fileUrl}" controls autoplay></audio>
                </div>`;
        }
        
        document.getElementById('media-modal').style.display = 'flex';
    }

    function closeMedia() {
        let container = document.getElementById('media-container');
        
        // [Báº¢N VÃ]: TÃ¬m táº¥t cáº£ cÃ¡c file Audio/Video Ä‘ang bá»‹ áº©n bÃªn trong
        let mediaElements = container.querySelectorAll('video, audio');
        
        mediaElements.forEach(media => {
            media.pause();         // 1. Ã‰p dá»«ng phÃ¡t
            media.removeAttribute('src'); // 2. RÃºt phÃ­ch cáº¯m nguá»“n dá»¯ liá»‡u
            media.load();          // 3. Ã‰p trÃ¬nh duyá»‡t há»§y káº¿t ná»‘i Socket vá»›i ESP32 ngay láº­p tá»©c!
        });

        // 4. Giáº¥u khung vÃ  dá»n rÃ¡c HTML
        document.getElementById('media-modal').style.display = 'none';
        container.innerHTML = ''; 
    }

    function downloadFile(name) { 
        let fullPath = currentPath + name;
        let downloadUrl = `/api/download?path=${encodeURIComponent(fullPath)}`;
        let a = document.createElement('a');
        a.href = downloadUrl;
        a.download = name; 
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }
    
    function deleteItem(name, isDir) {
        if(confirm(`> WARNING: OVERRIDE PROTOCOL. PURGE [${name}]?`)) {
            fetch(`/api/delete`, { method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: `path=${encodeURIComponent(currentPath + name)}` })
            .then(() => refreshList());
        }
    }
    
    function createFolder() {
        let name = prompt("> ENTER NEW DIRECTORY ALIAS:");
        if (name) {
            fetch('/api/mkdir', { method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: `path=${encodeURIComponent(currentPath + name)}` })
            .then(() => refreshList());
        }
    }
    
    // =========================================================================
    // [Má»šI] TÃCH Há»¢P Há»† THá»NG THANH TIáº¾N TRÃŒNH UPLOAD Sá»¬ Dá»¤NG XHR
    // =========================================================================
    function uploadFileWithProgress(input) {
        if(input.files.length > 0) { 
            let file = input.files[0];
            let formData = new FormData();
            formData.append("file", file);
            
            // Váº½ Giao diá»‡n thanh Upload Progress
            const tbody = document.getElementById("file-list");
            tbody.innerHTML = `
                <tr>
                    <td colspan="3" style="padding: 40px 10px;">
                        <div class="progress-text">> INJECTING PAYLOAD: <span id="upload-percent">0%</span></div>
                        <div class="progress-container">
                            <div id="upload-fill" class="progress-fill"></div>
                        </div>
                    </td>
                </tr>
            `;

            // Khá»Ÿi táº¡o cÃ´ng cá»¥ XHR Ä‘á»ƒ theo dÃµi byte Ä‘Æ°á»£c truyá»n qua WiFi
            let xhr = new XMLHttpRequest();
            xhr.open("POST", `/api/upload?dir=${encodeURIComponent(currentPath)}`);

            // Sá»± kiá»‡n báº¯t nhá»‹p thay Ä‘á»•i tiáº¿n trÃ¬nh
            xhr.upload.onprogress = function(event) {
                if (event.lengthComputable) {
                    let percentComplete = Math.round((event.loaded / event.total) * 100);
                    
                    document.getElementById("upload-percent").innerText = percentComplete + "%";
                    
                    let fillBar = document.getElementById("upload-fill");
                    fillBar.style.width = percentComplete + "%";
                    
                    // Khi truyá»n xong 100%, Ä‘á»•i mÃ u xanh lÃ¡ bÃ¡o hiá»‡u lÆ°u Flash thÃ nh cÃ´ng
                    if (percentComplete === 100) {
                        document.getElementById("upload-percent").innerText = "WRITING TO FLASH...";
                        fillBar.style.background = "var(--neon-green)";
                        fillBar.style.boxShadow = "0 0 15px var(--neon-green)";
                    }
                }
            };

            // Sá»± kiá»‡n truyá»n xong xuÃ´i khÃ´ng lá»—i láº§m
            xhr.onload = function() {
                input.value = ""; 
                // [Báº¢N VÃ]: Delay 1.2 giÃ¢y Ä‘á»ƒ ESP32 cÃ³ thá»i gian Ä‘Ã³ng file vÃ  giáº£i phÃ³ng RAM
                setTimeout(refreshList, 1200);
            };

            // Sá»± kiá»‡n Ä‘á»©t gÃ¡nh giá»¯a Ä‘Æ°á»ng (Máº¥t máº¡ng, rÃºt Ä‘iá»‡n ESP)
            xhr.onerror = function() {
                tbody.innerHTML = '<tr><td colspan="3" style="color:var(--neon-red); text-align:center; padding:30px; font-weight:bold;">> UPLOAD FAILED: LINK BROKEN</td></tr>';
                setTimeout(refreshList, 2000);
            };

            // PhÃ¡t há»a!
            xhr.send(formData);
        }
    }

    let currentEditPath = "";
    function editFile(name) {
        currentEditPath = currentPath + name;
        document.getElementById('editor-title').innerHTML = `<span style="animation: blink 1s infinite;">â–ˆ</span> SYS.EDIT // ${name}`;
        fetch(`/api/download?path=${encodeURIComponent(currentEditPath)}`).then(res => res.text()).then(text => {
            document.getElementById('editor-textarea').value = text;
            document.getElementById('editor-modal').style.display = 'flex';
        });
    }

    function closeEditor() { document.getElementById('editor-modal').style.display = 'none'; }
    
    function saveFile() { 
        let content = document.getElementById('editor-textarea').value;
        document.getElementById('editor-title').innerHTML = `<span style="animation: blink 0.2s infinite; color: var(--neon-yellow);">â–ˆ</span> > WRITING BLOCKS...`;
        fetch('/api/save', {
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body: `path=${encodeURIComponent(currentEditPath)}&content=${encodeURIComponent(content)}`
        }).then(() => { closeEditor(); refreshList(); });
    }

    window.onload = function() {
        document.getElementById('ip-display').innerText = window.location.host || "OFFLINE";
        refreshList(); 
    };
</script>

</body>
</html>
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀	␀␀␀
